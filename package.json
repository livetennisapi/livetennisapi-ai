{
  "name": "livetennisapi-ai",
  "version": "1.3.0",
  "description": "Vercel AI SDK tools for live tennis data. Give an AI SDK agent real-time scores, players, player stats, fixtures, rankings, head-to-head, the 1968-2022 results archive, market prices and win probability from Live Tennis API. ATP, WTA, Challenger, ITF and juniors.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-sdk-tools",
    "tool",
    "tools",
    "llm",
    "ai-agent",
    "tool-calling",
    "generate-text",
    "tennis",
    "tennis-api",
    "live-scores",
    "sports",
    "sports-api",
    "sports-data",
    "atp",
    "wta",
    "agents",
    "ai-agents",
    "agent-tools",
    "tennis-data",
    "tennis-scores",
    "tennis-stats",
    "player-stats",
    "livetennisapi",
    "stream-text"
  ],
  "homepage": "https://docs.livetennisapi.com/ai-sdk.html",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/livetennisapi/livetennisapi-ai.git"
  },
  "bugs": {
    "url": "https://gitlab.com/livetennisapi/livetennisapi-ai/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Synapse Research Ltd",
    "email": "hello@livetennisapi.com",
    "url": "https://synapsereality.io"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/tools-output.mjs && node test/errors.mjs && node test/generate-text.mjs",
    "test:tools": "node test/tools-output.mjs",
    "test:errors": "node test/errors.mjs",
    "test:generate": "node test/generate-text.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "livetennisapi": "^1.10.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
